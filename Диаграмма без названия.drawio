        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;%%{init: {\&quot;theme\&quot;:\&quot;dark\&quot;,\&quot;flowchart\&quot;:{\&quot;curve\&quot;:\&quot;basis\&quot;,\&quot;nodeSpacing\&quot;:18,\&quot;rankSpacing\&quot;:28}}}%%\nflowchart LR\n\n  %% Левая сторона: примеры → виды тестирования → главная ветка\n  LH[\&quot;Характеристики&lt;br/&gt;и надёжность\&quot;]\n\n  L1[\&quot;Security Testing\&quot;] --&gt; LH\n  L1a[\&quot;Защищены ли данные?\&quot;] --&gt; L1\n  L1b[\&quot;Можно ли обойти блокировку?\&quot;] --&gt; L1\n\n  L2[\&quot;Beta Testing\&quot;] --&gt; LH\n  L2a[\&quot;Стабильна ли тестовая версия?\&quot;] --&gt; L2\n  L2b[\&quot;Не теряются ли данные после обновления?\&quot;] --&gt; L2\n\n  L3[\&quot;Automated Testing\&quot;] --&gt; LH\n  L3a[\&quot;Проверка звонков и сообщений\&quot;] --&gt; L3\n  L3b[\&quot;Проверка установки приложений\&quot;] --&gt; L3\n\n  L4[\&quot;Validation\&quot;] --&gt; LH\n  L4a[\&quot;Работает ли телефон на морозе и в жару?\&quot;] --&gt; L4\n  L4b[\&quot;Хватает ли заряда на день?\&quot;] --&gt; L4\n\n  L5[\&quot;Verification\&quot;] --&gt; LH\n  L5a[\&quot;Исправны ли кнопки и сканер отпечатка?\&quot;] --&gt; L5\n  L5b[\&quot;Совпадают ли характеристики с заявленными?\&quot;] --&gt; L5\n\n  L6[\&quot;Negative Testing\&quot;] --&gt; LH\n  L6a[\&quot;Что будет при заполненной памяти?\&quot;] --&gt; L6\n  L6b[\&quot;Что произойдёт при сбое обновления?\&quot;] --&gt; L6\n\n  L7[\&quot;Stress Testing\&quot;] --&gt; LH\n  L7a[\&quot;Не перегревается ли телефон под нагрузкой?\&quot;] --&gt; L7\n  L7b[\&quot;Не разряжается ли батарея слишком быстро?\&quot;] --&gt; L7\n\n  L8[\&quot;Recovery Testing\&quot;] --&gt; LH\n  L8a[\&quot;Восстанавливается ли телефон после сбоя?\&quot;] --&gt; L8\n  L8b[\&quot;Можно ли вернуть резервную копию?\&quot;] --&gt; L8\n\n  L9[\&quot;Documentation Testing\&quot;] --&gt; LH\n  L9a[\&quot;Понятны ли инструкции и сообщения об ошибках?\&quot;] --&gt; L9\n\n  L10[\&quot;UI / UX Testing\&quot;] --&gt; LH\n  L10a[\&quot;Удобно ли пользоваться одной рукой?\&quot;] --&gt; L10\n  L10b[\&quot;Хорошо ли виден экран на солнце?\&quot;] --&gt; L10\n\n  L11[\&quot;Entry Point Testing\&quot;] --&gt; LH\n  L11a[\&quot;Проходит ли первичная настройка?\&quot;] --&gt; L11\n  L11b[\&quot;Можно ли перенести данные со старого телефона?\&quot;] --&gt; L11\n\n  %% Центр\n  LH --&gt; S[\&quot;Смартфон\&quot;] --&gt; RH[\&quot;Функциональность&lt;br/&gt;и совместимость\&quot;]\n\n  %% Правая сторона: главная ветка → виды тестирования → примеры\n  RH --&gt; R1[\&quot;Black Box Testing\&quot;]\n  R1 --&gt; R1a[\&quot;Делает ли камера снимок по нажатию?\&quot;]\n  R1 --&gt; R1b[\&quot;Работают ли функции без сбоев?\&quot;]\n\n  RH --&gt; R2[\&quot;White / Grey Box\&quot;]\n  R2 --&gt; R2a[\&quot;Что показывают системные журналы ошибок?\&quot;]\n  R2 --&gt; R2b[\&quot;Нет ли чрезмерного расхода ресурсов?\&quot;]\n\n  RH --&gt; R3[\&quot;Smoke &amp; Sanity\&quot;]\n  R3 --&gt; R3a[\&quot;Включается ли телефон после обновления?\&quot;]\n  R3 --&gt; R3b[\&quot;Работают ли звонки и интернет?\&quot;]\n\n  RH --&gt; R4[\&quot;Functional Testing\&quot;]\n  R4 --&gt; R4a[\&quot;Работают ли камера, микрофон и динамики?\&quot;]\n  R4 --&gt; R4b[\&quot;Сохраняются ли фото и контакты?\&quot;]\n\n  RH --&gt; R5[\&quot;Usability Testing\&quot;]\n  R5 --&gt; R5a[\&quot;Удобно ли разблокировать экран?\&quot;]\n  R5 --&gt; R5b[\&quot;Не мешают ли уведомления и системные звуки?\&quot;]\n\n  RH --&gt; R6[\&quot;Compatibility Testing\&quot;]\n  R6 --&gt; R6a[\&quot;Подключаются ли Wi‑Fi и Bluetooth?\&quot;]\n  R6 --&gt; R6b[\&quot;Работают ли SIM, eSIM и NFC?\&quot;]\n  R6 --&gt; R6c[\&quot;Совместимы ли зарядка и аксессуары?\&quot;]\n  R6 --&gt; R6d[\&quot;Запускаются ли нужные приложения?\&quot;]\n\n  RH --&gt; R7[\&quot;Performance Testing\&quot;]\n  R7 --&gt; R7a[\&quot;Быстро ли запускаются приложения?\&quot;]\n  R7 --&gt; R7b[\&quot;Как долго работает батарея?\&quot;]\n\n  RH --&gt; R8[\&quot;Component Testing\&quot;]\n  R8 --&gt; R8a[\&quot;Исправны ли экран и сенсор?\&quot;]\n  R8 --&gt; R8b[\&quot;Работают ли камеры и разъём зарядки?\&quot;]\n\n  RH --&gt; R9[\&quot;Integration Testing\&quot;]\n  R9 --&gt; R9a[\&quot;Синхронизируются ли фото с облаком?\&quot;]\n  R9 --&gt; R9b[\&quot;Переключается ли телефон между сетями?\&quot;]\n\n  RH --&gt; R10[\&quot;Regression Testing\&quot;]\n  R10 --&gt; R10a[\&quot;Не сломались ли функции после обновления?\&quot;]\n  R10 --&gt; R10b[\&quot;Запускаются ли прежние приложения?\&quot;]\n\n  RH --&gt; R11[\&quot;Localization Testing\&quot;]\n  R11 --&gt; R11a[\&quot;Корректно ли отображаются язык и дата?\&quot;]\n  R11 --&gt; R11b[\&quot;Не обрезается ли текст в меню?\&quot;]\n\n  classDef main fill:#171717,stroke:#ddd,color:#fff,stroke-width:2px;\n  classDef category fill:#171717,stroke:#aaa,color:#fff,stroke-width:1.5px;\n  classDef example fill:#171717,stroke:#777,color:#eee,stroke-width:1px;\n\n  class S main;\n  class LH,RH,L1,L2,L3,L4,L5,L6,L7,L8,L9,L10,L11,R1,R2,R3,R4,R5,R6,R7,R8,R9,R10,R11 category;\n  class L1a,L1b,L2a,L2b,L3a,L3b,L4a,L4b,L5a,L5b,L6a,L6b,L7a,L7b,L8a,L8b,L9a,L10a,L10b,L11a,L11b,R1a,R1b,R2a,R2b,R3a,R3b,R4a,R4b,R5a,R5b,R6a,R6b,R6c,R6d,R7a,R7b,R8a,R8b,R9a,R9b,R10a,R10b,R11a,R11b example;&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="sqApWHwe5cXSWCXMyIn3-141">
